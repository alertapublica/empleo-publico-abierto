{
  "$schema": "https://unpkg.com/wrangler@4.147.0/config-schema.json",
  // Avisos por Telegram y correo. Los datos de las ofertas siguen en GitHub Pages: aquí solo
  // están las suscripciones (D1) y la bandeja de salida.
  "name": "empleo-avisos",
  "account_id": "a8183539272f1346a4e6fe05a5c5ee29",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  // URL pública (URL_PUBLICA) para el webhook de Telegram, el formulario y los enlaces del correo.
  // Crearla exige que el token de despliegue tenga «Zone › Workers Routes › Edit» en alertapublica.es.
  "routes": [{ "pattern": "avisos.alertapublica.es", "custom_domain": true }],
  // La dirección de workers.dev sigue activa mientras dura el cambio de dominio.
  "workers_dev": true,
  "preview_urls": false,
  // Registros sin datos personales: el código no escribe chats, correos ni mensajes.
  "observability": { "enabled": true },
  "triggers": {
    // Cada minuto vacía la bandeja de salida; a las 6:00 UTC prepara el resumen diario por correo.
    // Deben coincidir con CRON_ENVIOS y CRON_CORREO de src/index.js.
    "crons": ["* * * * *", "0 6 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "empleo-avisos",
      "database_id": "479bff1c-7005-473a-a092-2c91c145ffad",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "URL_PUBLICA": "https://avisos.alertapublica.es",
    // Correo por el SMTP del buzón de Piensa (TLS en el 465). Con «no» no hay altas ni resumen
    // diario, pero funciona la ruta /interno/correo-prueba. Con «si», las altas exigen un token de
    // Turnstile emitido en alertapublica.es: el interruptor público es la variable CORREO_SITEKEY del
    // repo, que hace aparecer el formulario en la web.
    "CORREO_ACTIVO": "si",
    "CORREO_REMITENTE": "avisos@alertapublica.es",
    "CORREO_NOMBRE": "Empleo en Empresas Públicas",
    // Correos por tanda (una por minuto). Ajustar al límite de envío del buzón.
    "CORREO_POR_TANDA": "20",
    "SMTP_SERVIDOR": "smtp.buzondecorreo.com",
    "SMTP_PUERTO": "465",
    "SMTP_USUARIO": "avisos@alertapublica.es"
  }
  // Secretos (wrangler secret put): AVISOS_CLAVE (la misma que el secreto de GitHub), TELEGRAM_TOKEN
  // (de BotFather), TELEGRAM_SECRETO (cadena aleatoria para el webhook), SMTP_CLAVE (contraseña del
  // buzón) y, con el formulario, TURNSTILE_SECRETO.
}
